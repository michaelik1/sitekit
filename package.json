{
  "name": "dacha-praktik-decoy",
  "version": "2.0.1",
  "private": true,
  "description": "Production-ready editorial decoy site about gardening, built with Nuxt 4 and file-based content.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "content:build": "node scripts/prepare-content.mjs",
    "content:check": "node scripts/prepare-content.mjs --check",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/prepare-content.mjs && nuxt build",
    "generate": "node scripts/prepare-content.mjs && nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "node scripts/prepare-content.mjs --check && nuxt prepare && tsc --noEmit -p tsconfig.json && node scripts/check-source.mjs",
    "check": "npm run typecheck && npm run build",
    "new:article": "node scripts/new-article.mjs",
    "new:video": "node scripts/new-video.mjs",
    "media:manifest": "node scripts/media-manifest.mjs",
    "media:sync": "node scripts/sync-media.mjs",
    "media:upload:r2": "node scripts/upload-media-r2.mjs",
    "source:check": "node scripts/check-source.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1087.0",
    "nuxt": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
