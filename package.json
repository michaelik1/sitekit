{
  "name": "directory-site-engine",
  "version": "3.0.0",
  "private": true,
  "description": "A small Nuxt site engine powered by a mounted directory of YAML pages and media.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "content:check": "node --experimental-strip-types tools/validate-content.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run test && npm run content:check && npm run typecheck && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "marked": "^16.0.0",
    "nuxt": "^4.0.0",
    "sanitize-html": "^2.17.0",
    "vue": "^3.5.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0"
  }
}
